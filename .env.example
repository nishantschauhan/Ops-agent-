# --- LLM provider ---
# Set ONE of these. If both are set, force a choice with LLM_PROVIDER;
# otherwise Anthropic is preferred when both are present.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# LLM_PROVIDER=gemini
# ANTHROPIC_MODEL=claude-sonnet-5
# GEMINI_MODEL=gemini-flash-lite-latest

# Simulated per-server auth. Each MCP server refuses to boot unless its own
# key is present in the environment (see common/auth.py). The orchestrator
# forwards its whole environment to each subprocess, so setting these here
# is enough for both the agent and Claude Desktop.
DB_API_KEY=dev-db-key
TICKETING_API_KEY=dev-ticketing-key
KB_API_KEY=dev-kb-key

# Optional strict-match variables. Leave unset to just require presence of
# the key above; set these too to make a server refuse to boot on a mismatch
# (e.g. rotate DB_API_KEY_EXPECTED without updating DB_API_KEY to see it
# refuse to start).
# DB_API_KEY_EXPECTED=dev-db-key
# TICKETING_API_KEY_EXPECTED=dev-ticketing-key
# KB_API_KEY_EXPECTED=dev-kb-key
